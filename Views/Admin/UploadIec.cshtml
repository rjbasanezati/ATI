@model ATI_IEC.Models.IecDocument

@{
    ViewData["Title"] = "Upload IEC";
}

<link rel="stylesheet" href="~/css/site-main.css" />

<style>

/* ================= HERO ================= */

.hero {
    position: relative;
    width: 100%;
    min-height: 100vh;   /* instead of height */
    overflow: auto;     /* allow scrolling */
}

.hero-overlay {
    min-height: 100%;
}


.hero video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background: rgba(31,111,67,.6);
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
}

/* ================= CONTENT ================= */

.hero-content {
    width: 100%;
    max-width: 1100px;
    color: white;
}

.hero-content h1 {
    text-align: center;
    margin-bottom: 30px;
    text-shadow: 2px 2px 8px rgba(0,0,0,.6);
}

/* ================= CARD ================= */

.upload-card {
    background: white;
    padding: 30px;
    border-radius: 10px;
    margin-bottom: 40px;
}

.upload-card h2,
.upload-card h3 {
    color: #1f6f43;
}

/* ================= BUTTON ================= */

.btn-primary {
    background: #1f6f43;
    border: none;
}

.btn-primary:hover {
    background: #14532d;
}

/* ================= RESPONSIVE ================= */

@@media (max-width:768px) {

    .upload-card {
        padding: 20px;
    }

    iframe {
        height: 200px;
    }
}
.upload-card label,
.upload-card h2,
.upload-card h3 {
    color: #1f6f43;
    font-weight: 600;
}

table {
    background: white;
}

th {
    color: #1f6f43;
}

td {
    vertical-align: middle;
}

</style>

<header>
    <div class="main-title">
        AGRICULTURAL TRAINING INSTITUTE - RTC XI PORTAL
    </div>
</header>

<section class="hero">

    <video autoplay muted loop playsinline>
        <source src="@Url.Content("~/videos/farm.mp4")" type="video/mp4" />
    </video>

    <div class="hero-overlay">

        <div class="hero-content">

            <h1>Upload IEC Material</h1>

            <div class="upload-card">

                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success">@TempData["Success"]</div>
                }

                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger">@TempData["Error"]</div>
                }

                <!-- Upload Form -->

                <form asp-action="UploadIec" method="post" enctype="multipart/form-data">

                    <div class="mb-3">
                        <label>Title</label>
                        <input asp-for="Title" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label>Description (optional)</label>
                        <input asp-for="Description" class="form-control" />
                    </div>

                    <div class="mb-3">
                        <label>Select File</label>
                        <input type="file" name="uploadedFile" class="form-control" required />
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Upload
                    </button>

                </form>

            </div>
            <!-- ================= IEC LIST ================= -->

<div class="upload-card">

    <h3>Uploaded IEC Documents</h3>

    <table class="table table-striped table-hover">

        <thead>
            <tr>
                <th>Title</th>
                <th>Description</th>
                <th>Date Uploaded</th>
                <th width="160">Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var doc in ViewBag.IecDocuments as List<ATI_IEC.Models.IecDocument>)
            {
                <tr>

                    <td>@doc.Title</td>

                    <td>
                        @if (!string.IsNullOrEmpty(doc.Description))
                        {
                            @doc.Description
                        }
                        else
                        {
                            <span class="text-muted">—</span>
                        }
                    </td>

                    <td>
                        @doc.UploadDate.ToString("MMM dd, yyyy")
                    </td>

                    <td>

                        <a href="@doc.FilePath"
                           target="_blank"
                           class="btn btn-sm btn-primary">
                            Open
                        </a>

                        <form asp-action="DeleteIec"
                              method="post"
                              class="d-inline">

                            <input type="hidden" name="id" value="@doc.Id" />

                            <button type="submit"
                                    class="btn btn-sm btn-danger"
                                    onclick="return confirm('Delete this IEC?');">
                                Delete
                            </button>

                        </form>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>


           

</section>

<footer>
    © @DateTime.Now.Year Agricultural Training Institute - RTC XI. All Rights Reserved – RJB
</footer>
