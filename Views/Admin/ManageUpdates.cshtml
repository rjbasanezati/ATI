@model ATI_IEC.Models.AdminViewModel

<div class="upload-card">
    <h3 class="text-center mb-3">Manage Updates</h3>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success text-center">@TempData["Success"]</div>
    }

    @foreach (var type in new[] { "TMS", "Announcement", "Calendar" })
    {
        <div class="mb-4">
            <h4>@type Updates</h4>

            <!-- Add new update -->
            <form asp-action="AddUpdate" method="post" class="mb-2">
                <input type="hidden" name="type" value="@type" />
                <textarea name="content" class="form-control mb-1" placeholder="Add new @type update..."></textarea>
                <button type="submit" class="btn btn-success btn-sm">Add</button>
            </form>

            <!-- List existing updates with delete button -->
            <ul class="list-group">
                @foreach (var item in type == "TMS" ? Model.TMSUpdates :
                                        type == "Announcement" ? Model.Announcements :
                                        Model.CalendarEvents)
                {
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        @item.Content
                        <form asp-action="DeleteUpdate" method="post" style="margin:0;">
                            <input type="hidden" name="id" value="@item.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </li>
                }
            </ul>
        </div>
    }
</div>
