@model ATI_IEC.Models.FitsCenter
@{
    ViewData["Title"] = "Edit FITS Center";
}

<div class="container mt-4">
    <h2>Edit FITS Center</h2>

    <form asp-action="EditFitsCenter" method="post">
        <input type="hidden" asp-for="Id" />

        <div class="mb-2">
            <label asp-for="CenterName" class="form-label"></label>
            <input asp-for="CenterName" class="form-control" />
        </div>

        <div class="mb-2">
            <label asp-for="LaunchedDate" class="form-label"></label>
            <input asp-for="LaunchedDate" type="date" class="form-control" />
        </div>

        <div class="mb-2">
            <label asp-for="Status" class="form-label"></label>
            <select asp-for="Status" class="form-control">
                <option>Active</option>
                <option>Inactive</option>
            </select>
        </div>

        <div class="mb-2">
            <label asp-for="Address" class="form-label"></label>
            <input asp-for="Address" class="form-control" />
        </div>

        <div class="mb-2">
            <label asp-for="InCharge" class="form-label"></label>
            <input asp-for="InCharge" class="form-control" />
        </div>

        <div class="mb-2">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" type="email" class="form-control" />
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        <a asp-action="ManageFITS" class="btn btn-secondary">Cancel</a>
    </form>
</div>
