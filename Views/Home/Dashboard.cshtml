<div class="container mt-5">
    <h2 class="mb-4">Dashboard</h2>
    <p>Welcome! Please choose an option below:</p>

    <div class="row mt-4">
        <div class="col-md-6 mb-3">
            <div class="card shadow-lg p-4 text-center">
                <h4>📚 IEC Library</h4>
                <p>Browse and read IEC materials.</p>
                <a asp-controller="Home" asp-action="IecLibrary" class="btn btn-primary">
                    Go to IEC Library
                </a>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card shadow-lg p-4 text-center">
                <h4>📝 Request KPS</h4>
                <p>Submit a Knowledge Product Support request.</p>
                <a asp-controller="Kps" asp-action="Instructions" class="btn btn-success">
                    Request KPS
                </a>
            </div>
        </div>
    </div>

    <!-- Centered Back to Home -->
    <div class="text-center mt-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-secondary">
            ⬅ Back to Home
        </a>
    </div>
</div>
