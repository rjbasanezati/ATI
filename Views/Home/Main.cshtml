@{
    ViewData["Title"] = "Main Dashboard";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <link rel="stylesheet" href="~/css/site-main.css" />

    <style>
        /* ================= HERO ================= */
        .hero {
            position: relative;
            width: 100%;
            height: 100vh; /* full screen */
            overflow: hidden;
        }

        .hero video {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            z-index: 0;
        }

        .hero-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(31, 111, 67, 0.6); /* dark overlay */
            display: flex;
            flex-direction: column;
            justify-content: center; /* vertical center */
            align-items: center;     /* horizontal center */
            z-index: 1;
            padding: 20px;
            text-align: center;
        }

        .hero-content h1 {
            color: #fff;
            font-size: 36px;
            margin-bottom: 40px;
            text-shadow: 2px 2px 8px rgba(0,0,0,0.6);
        }

        .hero-buttons-container {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 20px;
            max-width: 1000px;
            width: 100%;
        }

        .hero-btn {
            display: block;
            padding: 25px 20px;
            background-color: #2e7d32;
            color: #fff;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            text-decoration: none;
            transition: all 0.3s ease;
            text-align: center;
            min-height: 120px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .hero-btn:hover {
            background-color: #1f6f43;
            transform: translateY(-5px);
        }

        /* ================= FOOTER ================= */
        footer {
            background-color: #163f28;
            color: #ffffff;
            padding: 24px 40px;
            text-align: center;
        }

        /* ================= RESPONSIVE ================= */
        @@media(max-width:900px) {
            .hero-buttons-container {
                grid-template-columns: repeat(2,1fr);
            }
        }

        @@media(max-width:600px) {
            .hero-buttons-container {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>

<body>

<header>
    <div class="main-title">
        AGRICULTURAL TRAINING INSTITUTE - RTC XI PORTAL
    </div>
</header>

<!-- ================= HERO ================= -->
<section class="hero">

    <video autoplay muted loop playsinline>
        <source src="@Url.Content("~/videos/farm.mp4")" type="video/mp4" />
    </video>

    <div class="hero-overlay">
        <div class="hero-content">

            <h1>Please choose your transaction</h1>

            <!-- ================= DASHBOARD BUTTONS ================= -->
            <div class="hero-buttons-container">

                <a class="hero-btn" asp-controller="Home" asp-action="ISS">
                    Information Services Section (ISS)
                </a>

                <a class="hero-btn" asp-controller="Home" asp-action="PAS">
                    Partnership Accreditation Section (PAS)
                </a>

                <a class="hero-btn" asp-controller="Home" asp-action="CDMS">
                    Career Development and Management Section (CDMS)
                </a>

                <a class="hero-btn" asp-controller="Home" asp-action="AFU">
                    Admin and Finance Unit (AFU)
                </a>

                <a class="hero-btn" href="https://sites.google.com/ati.da.gov.ph/atidavao-pmeu/home" target="_blank">
                    Planning, Monitoring, Evaluation Unit (PMEU)
                </a>

                <a class="hero-btn" asp-controller="Home" asp-action="BAC">
                    Bids and Awards Committee (BAC)
                </a>

            </div>

        </div>
    </div>

</section>

<footer>
    © @DateTime.Now.Year Agricultural Training Institute - RTC XI. All Rights Reserved. - RJB
</footer>

</body>
</html>
