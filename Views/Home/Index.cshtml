@model ATI_IEC.Models.LoginViewModel

@{
    ViewData["Title"] = "Agricultural Training Institute";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- SITE CSS -->
    <link rel="stylesheet" href="~/css/site-index.css" />
</head>

<body>
<header>
    <div class="main-title">
        AGRICULTURAL TRAINING INSTITUTE - RTC XI PORTAL
    </div>

    <div class="header-top">
        <nav>
            <ul class="header-grid-menu">
                <li data-section="info"><a>Information Services Section (ISS)</a></li>
                <li data-section="partnership"><a>Partnership Accreditation Section (PAS)</a></li>
                <li data-section="career"><a>Career Development and Management Section (CDMS)</a></li>
                <li data-section="admin"><a>Admin and Finance Unit (AFU)</a></li>
                <li data-section="planning"><a>Planning, Monitoring, Evaluation Unit (PMEU)</a></li>
            </ul>
        </nav>
    </div>
</header>

<!-- ================= HERO SECTION ================= -->
<section class="hero">

    <video autoplay muted loop playsinline>
        <source src="@Url.Content("~/videos/farm.mp4")" type="video/mp4" />
    </video>

    <div class="hero-layout">

        <div class="hero-content">

            <div id="hub" class="hero-panel active">
                <h1>Welcome to ATI - RTC XI Portal</h1>
                <p class="hero-text">
                    Welcome to the ATI - RTC XI Portal, your centralized platform for accessing all ATI Davao Region online services.
                    Through this hub, ATI staff, partners, and stakeholders can stay informed about the latest programs, initiatives,
                    and essential announcements.
                </p>
            </div>

            <div id="info" class="hero-panel">
                <h1>Information Services Section (ISS)</h1>
                <p>Providing information, data, and resources to support ATI programs and services.</p>
            </div>

            <div id="partnership" class="hero-panel">
                <h1>Partnership Accreditation Section</h1>
                <p>Accrediting partnerships with LGUs, SUCs, and private institutions.</p>
            </div>

            <div id="career" class="hero-panel">
                <h1>Career Development and Management Section</h1>
                <p>Supports staff development and career growth.</p>
            </div>

            <div id="admin" class="hero-panel">
                <h1>Admin and Finance Unit</h1>
                <p>Handles administrative and financial operations.</p>
            </div>

            <div id="planning" class="hero-panel">
                <h1>Planning, Monitoring, Evaluation Unit</h1>
                <p>Focuses on planning, monitoring, and evaluation.</p>
            </div>

        </div>

        <!-- LOGIN -->
        <div class="login-card">
            <h3>ATI Staff Login</h3>

            <form asp-action="Index" method="post">
                @Html.AntiForgeryToken()

                <input asp-for="Email" placeholder="Username / Email" />
                <span asp-validation-for="Email" class="text-danger"></span>

                <input asp-for="Password" type="password" placeholder="Password" />
                <span asp-validation-for="Password" class="text-danger"></span>

                <button type="submit">Login</button>

                @if (ViewBag.Error != null)
                {
                    <div class="error-text">@ViewBag.Error</div>
                }
            </form>

            <small>Don't have an account? <a asp-action="Register">Create Account</a></small>
            <small>Administrative Access <a asp-controller="Admin" asp-action="Login">Sign In</a></small>
        </div>

    </div>
</section>
<!-- ================= INFO BOXES SECTION ================= -->
<section class="ati-section">
    <div class="ati-box-container">
        <div class="ati-box">
            <h3>TMS UPDATES</h3>
            <!-- Dynamic content placeholder -->
            <div id="tms-updates">
                @* Example: loop through updates from database *@
                @* @foreach(var update in Model.TmsUpdates) { <p>@update.Text</p> } *@
                <p>No updates yet.</p>
            </div>
        </div>

        <div class="ati-box">
            <h3>ANNOUNCEMENTS</h3>
            <!-- Dynamic content placeholder -->
            <div id="announcements">
                @* @foreach(var announcement in Model.Announcements) { <p>@announcement.Text</p> } *@
                <p>No announcements yet.</p>
            </div>
        </div>

        <div class="ati-box">
            <h3>ATI CALENDAR</h3>
            <!-- Dynamic content placeholder -->
            <div id="calendar-events">
                @* @foreach(var evt in Model.CalendarEvents) { <p>@evt.Date.ToString("MMM dd, yyyy") – @evt.Title</p> } *@
                <p>No events scheduled.</p>
            </div>
        </div>
    </div>
</section>



<footer>
    © @DateTime.Now.Year Agricultural Training Institute - RTC XI. All Rights Reserved. - RJB
</footer>

<script>
    const menuItems = document.querySelectorAll('nav li');
    const heroPanels = document.querySelectorAll('.hero-panel');

    menuItems.forEach(item => {
        item.addEventListener('click', () => {
            const target = item.getAttribute('data-section');
            heroPanels.forEach(panel => {
                panel.classList.toggle('active', panel.id === target);
            });
        });
    });
</script>

</body>
</html>
